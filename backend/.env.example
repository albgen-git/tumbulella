# Copia questo file in ".env" (stesso folder) e inserisci la tua chiave.
# ".env" è ignorato da git (vedi .gitignore) — non finisce mai nel repo.
#
# Chiave dell'API Gemini (Google AI Studio: https://aistudio.google.com/apikey)
GEMINI_API_KEY=AIza...

# Opzionale: sovrascrive il modello di default (gemini-flash-latest).
# TUMBULELLA_MODEL=gemini-flash-latest

# Opzionale: notifiche errori via Sentry (sentry.io). Se non impostata,
# Sentry resta semplicemente disattivato — nessun errore, nessuna chiamata.
# SENTRY_DSN=https://xxxxxxxx@oXXXXXXX.ingest.de.sentry.io/XXXXXXX

# Opzionale: cruscotto d'uso della consolle admin (tab Dashboard). Token
# GitHub con scope SOLO "gist" (mai "repo" — non deve poter toccare il
# codice sorgente) e l'ID del gist privato dove vengono salvati i contatori
# aggregati. Se una delle due manca, i contatori restano solo in memoria
# per la durata del processo e non vengono mai salvati.
# GITHUB_STATS_TOKEN=github_pat_...
# GITHUB_STATS_GIST_ID=...

# Opzionale: tab Dashboard della consolle admin, sezione "Salute Render" —
# chiave API generata da Render (Account Settings > API Keys). RENDER_SERVICE_ID
# è facoltativo: se assente, la consolle cerca da sola il servizio il cui nome
# contiene "tumbulella".
# RENDER_API_KEY=rnd_...
# RENDER_SERVICE_ID=srv-...
